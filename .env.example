# Values for running on your machine (`pnpm dev`) against the Docker infra
# (`docker compose up mysql`). Inside Docker Compose, hosts and ports
# are overridden in docker-compose.yml.
PORT=4001
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3307
MYSQL_USER=auth
MYSQL_PASSWORD=auth
MYSQL_DATABASE=auth

# RS256 signing key. Generate with: pnpm gen-keys >> .env
# Without it (dev only) a temporary key is used and everyone is logged out on restart.
# JWT_KEY_ID=
# JWT_PRIVATE_KEY=
# During key rotation only:
# JWT_PREVIOUS_KEY_ID=
# JWT_PREVIOUS_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# Same OAuth client ID as the frontend. Empty = dev-only "simulate Google" mode.
GOOGLE_CLIENT_ID=

# Your SMTP provider (e.g. Resend: smtp.resend.com, port 465, SMTP_SECURE=true;
# or port 587 with SMTP_SECURE=false for STARTTLS). Required in production.
# Empty SMTP_HOST (dev only) = emails are written to the log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tej Organics <no-reply@tejorganics.local>

# Shared by all services for service-to-service calls (order-service reads
# shoppers and saved addresses). Required in production (at least 32 random
# characters, e.g. `openssl rand -base64 48`).
# SERVICE_TOKEN_SECRET=
