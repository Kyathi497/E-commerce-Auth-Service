generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  user
  admin
}

enum UserStatus {
  active
  locked
  deleted
}

enum VerificationType {
  email_verify
  password_reset
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  name            String
  passwordHash    String?
  googleId        String?    @unique
  role            Role       @default(user)
  phone           String?    @unique @db.VarChar(15)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?
  marketingOptIn  Boolean    @default(false)
  failedLogins    Int        @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  addresses          Address[]

  @@index([createdAt])
}

// Rotating refresh tokens (§6.2). Only the SHA-256 of the token is stored.
// Every token in a login session shares a familyId; reusing a rotated token
// revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  familyId     String
  tokenHash    String    @unique @db.Char(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ip           String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model VerificationToken {
  id        String           @id @default(uuid())
  userId    String
  type      VerificationType
  tokenHash String           @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @db.VarChar(30)
  name      String   @db.VarChar(80)
  phone     String   @db.VarChar(15)
  line1     String   @db.VarChar(200)
  line2     String?  @db.VarChar(120)
  landmark  String?  @db.VarChar(80)
  city      String   @db.VarChar(60)
  state     String   @db.VarChar(60)
  pincode   String   @db.Char(6)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id      String   @id @default(uuid())
  actorId String?
  action  String   @db.VarChar(64)
  target  String?
  ip      String?  @db.VarChar(64)
  at      DateTime @default(now())
  meta    Json?

  @@index([target])
  @@index([actorId])
  @@index([at])
}
